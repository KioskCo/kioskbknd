{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/db": ["node_modules/@workspace/db"],
      "@workspace/db/*": ["node_modules/@workspace/db/*"],
      "@workspace/api-zod": ["node_modules/@workspace/api-zod"],
      "@workspace/api-zod/*": ["node_modules/@workspace/api-zod/*"]
    }
  },
  "include": ["src"]
}
