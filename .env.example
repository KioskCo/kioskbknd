# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Sentry (error tracking) ───────────────────────────────────────────────────
# Get a DSN from https://sentry.io (Settings → Projects → Client Keys/DSN).
# Leave blank to disable Sentry.
SENTRY_DSN=

# ── Redis (BullMQ queues, rate limiting, locks) ───────────────────────────────
# Local: install Redis and point at it. On Railway, add the Redis plugin and copy
# the REDIS_URL it exposes here. BullMQ requires Redis >= 6.2.
#  redis://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/kiosk

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=6569f4270ef73902c852f42768368d4111f0866075ae77b4bf9f37ab89066f7661d284ebaa6609f1c98fcf86af774dbcbece01997a188840d7a0f78ac115eea9

# ── SMTP (email OTP delivery) ─────────────────────────────────────────────────
# Gmail: enable 2FA → create App Password at myaccount.google.com/apppasswords
# Yahoo/others: any SMTP credentials work — Nodemailer sends to any recipient address
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=keeosk.co@gmail.com
SMTP_PASS=vwbiqqglpcsjncbi
SMTP_FROM="Kiosk <noreply@kiosk.store>"
# Email address where vendor support messages are delivered (defaults to SMTP_USER if not set)
SUPPORT_EMAIL=keeosk.co@gmail.com

# ── WhatsApp Business API (Meta) — System-level ───────────────────────────────
# Used for platform messages (OTP via WhatsApp, order confirmations from Kiosk itself).
# Get from: developers.facebook.com → your app → WhatsApp → API Setup

# ── WhatsApp Business API (Meta) — Embedded Signup / Per-vendor OAuth ─────────
# Enables each merchant to connect their own WhatsApp Business Account.
# 1. Go to developers.facebook.com → Create App → Business type
# 2. Add "WhatsApp" product to the app
# 3. Under WhatsApp → Embedded Signup → get App ID and App Secret
# 4. Set redirect URI in App Dashboard → Facebook Login → OAuth Redirect URIs
META_APP_ID=37813168218281747
META_APP_SECRET=1ae15bb419d91cb7c1ce258e113f8be1
META_REDIRECT_URI=https://api.keeosk.store/api/whatsapp/oauth/callback
WHATSAPP_VERIFY_TOKEN=e876cbbe12855b603f17547b6a8b4f7db2d256a3a6aa1c873f0adb1c3d7acd29

# ── Flutterwave ────────────────────────────────────────────────────────────────
# Get from: dashboard.flutterwave.com → Settings → APIs
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-5cd6ffc7a384bc466c7dc6976ad35348-X
FLUTTERWAVE_WEBHOOK_SECRET_HASH=kiosk_webhook_2026
# Webhook hash — set a random string here, then enter the SAME string in:
# Flutterwave dashboard → Settings → Webhooks → "Secret Hash"

# ── Paystack ──────────────────────────────────────────────────────────────────
# Get from: dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_61e2a5aecc95fea4df60f6a2593df29a41e9cb6e

# ── Payments (gateway keys above) ─────────────────────────────────────────────
# Set ALLOW_MOCK_PAYMENTS=true to let dev flows mark orders paid / accept webhooks
# WITHOUT a real gateway key. Keep OFF (or unset) in production so payments stay
# fail-closed and can never be confirmed without a configured gateway secret.
ALLOW_MOCK_PAYMENTS=true

# ── Termii (SMS fallback for OTP & notifications) ─────────────────────────────
# Register at: termii.com → Dashboard → API Keys
# If not set, SMS fallback is silently skipped — WhatsApp OTP still works.
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=Kiosk   # must be an approved sender ID in your Termii account

# ── Terminal Africa (multi-carrier shipping aggregator — inter-city) ──────────
# Register at: app.terminal.africa → Settings → API
TERMINAL_AFRICA_API_KEY=sk_test_huK6w7vGJgl8PbClSiHn58FqklMqGt3o

# ── Kwik Delivery (last-mile, bikes, Lagos-focused) ───────────────────────────
# Get from: app.kwik.delivery/developer
KWIK_API_KEY=your_kwik_api_key

# ── Gokada (last-mile bikes + cars, Lagos) ────────────────────────────────────
# Request API access at: gokada.ng/business
GOKADA_API_KEY=your_gokada_api_key

# ── GIG Logistics (nationwide, all 36 states — largest Nigerian courier) ──────
# Register corporate account at: giglogistics.com → Corporate Portal
# Then request API access. Use username+password OR a static partner API key.
GIG_API_USERNAME=your_gig_corporate_email@company.com
GIG_API_PASSWORD=your_gig_corporate_password
GIG_API_KEY=   # leave blank if using username+password above

# ── Sendbox (nationwide multi-carrier, affordable rates, good API) ─────────────
# Register at: app.sendbox.co → Settings → API Keys
SENDBOX_API_KEY=your_sendbox_api_key
SENDBOX_SECRET_KEY=your_sendbox_secret_key

# ── Cloud Storage (pick ONE option — for product image uploads) ───────────────

# Option A: Cloudinary (recommended — free tier available)
# dashboard.cloudinary.com → Settings → API Keys
# Create an *unsigned* upload preset: Settings → Upload → Add preset → Unsigned
CLOUDINARY_CLOUD_NAME=dgwm9pwub
CLOUDINARY_API_KEY=426724971867753
CLOUDINARY_API_SECRET=IcKfXsZwqhVqOKBI7PnU-2HtzVk
CLOUDINARY_UPLOAD_PRESET=kiosk_co

# Option B: AWS S3
# IAM → create user → attach AmazonS3FullAccess (or scoped bucket policy) → Access Keys
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=eu-west-1
AWS_S3_BUCKET=your-kiosk-uploads-bucket

# Option C: Supabase Storage
# supabase.com → project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=uploads

# ── Admin accounts (comma-separated emails — bypass subscription payment) ─────
ADMIN_EMAILS=you@example.com

# ── Public store URL ──────────────────────────────────────────────────────────
# Base URL for merchant storefronts. Change only if using a custom domain.
SHOP_BASE_URL=https://keeosk.store/@

# ── Sentry (error monitoring — optional) ─────────────────────────────────────
# sentry.io → Create Project → Node.js → get DSN from Project Settings → Client Keys
# Leave blank in development; only set in production Railway env vars.
SENTRY_DSN=https://a1e183bee6090bc85fe51f5334423a3c@o4511858919407616.ingest.de.sentry.io/4511858976751696

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info   # debug | info | warn | error
